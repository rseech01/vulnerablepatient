<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Improve Post-Discharge Care | Multilingual Patient Readmission Assessment</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Free multilingual screening tool that estimates hospital readmission risk and connects South Florida patients to local 211 resources. Available in English, Spanish, and Haitian Creole." />
  <meta property="og:title" content="Improve Post-Discharge Care | Multilingual Readmission Assessment" />
  <meta property="og:description" content="Answer 8 questions to estimate readmission risk and get connected to local 211 social services in South Florida. Available in English, Spanish, and Haitian Creole." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.vulnerablepatients.com/" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:locale:alternate" content="es_US" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Improve Post-Discharge Care | Multilingual Readmission Assessment" />
  <meta name="twitter:description" content="Free screening tool connecting South Florida patients to 211 resources in English, Spanish, and Haitian Creole." />
  <style>
    * {
      box-sizing: border-box;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    body {
      margin: 0;
      padding: 16px;
      background: #f5f5f7;
      color: #222;
    }
    .app-container {
      max-width: 960px;
      margin: 0 auto;
    }
    header {
      margin-bottom: 16px;
    }
    header h1 {
      margin: 0 0 4px;
      font-size: 1.6rem;
    }
    header p {
      margin: 4px 0 8px;
      font-size: 0.95rem;
    }
    .top-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 8px;
    }
    .language-select,
    .county-select {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .language-select label,
    .county-select label {
      font-size: 0.9rem;
      font-weight: 500;
    }
    select {
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #888;
      font-size: 0.9rem;
      background: #fff;
    }
    /* Wizard: single-card at a time */
    .cards {
      position: relative;
      margin: 12px 0 20px;
    }
    .card {
      background: #ffffff;
      border-radius: 16px;
      padding: 24px 20px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      display: none;
      flex-direction: column;
      gap: 10px;
      max-width: 540px;
      margin: 0 auto;
    }
    .card.active {
      display: flex;
    }
    .card-emoji {
      font-size: 2.4rem;
      text-align: center;
      margin-bottom: 4px;
    }
    .card-options {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 8px;
    }
    .card-options label {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 1rem;
      cursor: pointer;
    }
    .card-options input[type="radio"] {
      accent-color: #007aff;
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    /* Progress bar */
    .progress-container {
      max-width: 540px;
      margin: 0 auto 16px;
    }
    .progress-bar {
      height: 6px;
      background: #e0e0e0;
      border-radius: 3px;
      overflow: hidden;
    }
    .progress-fill {
      height: 100%;
      background: #007aff;
      border-radius: 3px;
      transition: width 0.3s ease;
      width: 0%;
    }
    .progress-label {
      font-size: 0.85rem;
      color: #666;
      margin-top: 6px;
      text-align: center;
    }

    /* Wizard navigation */
    .wizard-nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 540px;
      margin: 16px auto 0;
      gap: 12px;
    }
    .wizard-nav button {
      min-width: 100px;
    }
    .btn-back {
      background: #e0e0e0;
      color: #333;
      box-shadow: none;
    }
    .btn-back:hover {
      background: #ccc;
      box-shadow: none;
    }
    .btn-next {
      margin-left: auto;
    }

    /* Hidden actions row — calculate/reset only shown at end */
    .actions {
      margin-top: 12px;
      display: none;
      flex-wrap: wrap;
      gap: 10px;
      align-items: center;
      justify-content: center;
      max-width: 540px;
      margin-left: auto;
      margin-right: auto;
    }
    .actions.visible {
      display: flex;
    }
    button {
      border: none;
      border-radius: 999px;
      padding: 10px 18px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      background: #007aff;
      color: #fff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
    button:active {
      transform: scale(0.98);
    }
    .result,
    .resources {
      background: #fff;
      border-radius: 12px;
      padding: 12px 14px;
      margin-top: 12px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
      font-size: 0.95rem;
    }
    .result-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .pill {
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .pill-low {
      background: #e5f8e9;
      color: #1d7a35;
    }
    .pill-medium {
      background: #fff6e5;
      color: #b06400;
    }
    .pill-high {
      background: #ffe5e5;
      color: #b00020;
    }
    .disclaimer {
      font-size: 0.8rem;
      color: #666;
      margin-top: 8px;
    }
    .resources-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .resources-title {
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .resources-title span.icon {
      font-size: 1.2rem;
    }
    .resources-meta {
      font-size: 0.85rem;
      color: #555;
      text-align: right;
    }
    .resource-list {
      margin: 10px 0 0;
      padding-left: 18px;
      font-size: 0.9rem;
    }
    .resource-list li {
      margin-bottom: 4px;
    }
    .tag {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 0.75rem;
      background: #f2f2f7;
      margin-left: 4px;
    }
    a.resource-link {
      color: #007aff;
      text-decoration: none;
    }
    a.resource-link:hover {
      text-decoration: underline;
    }

    /* Accessibility: visible focus rings */
    button:focus-visible,
    select:focus-visible,
    a:focus-visible {
      outline: 3px solid #005fcc;
      outline-offset: 2px;
    }
    input[type="radio"]:focus-visible {
      outline: 3px solid #005fcc;
      outline-offset: 2px;
    }

    /* Accessibility: enlarged touch targets for radio options */
    .card-options label {
      padding: 14px 12px;
      border-radius: 10px;
      border: 2px solid transparent;
      transition: background 0.15s, border-color 0.15s;
    }
    .card-options label:hover {
      background: #f2f2f7;
    }
    .card-options label:has(input:checked) {
      background: #e8f0fe;
      border-color: #007aff;
    }
    /* Accessibility: fieldset/legend reset */
    fieldset.card-radio-group {
      border: none;
      margin: 0;
      padding: 0;
    }
    fieldset.card-radio-group legend {
      font-weight: 600;
      font-size: 1.1rem;
      line-height: 1.4;
      padding: 0;
      margin: 0;
      width: 100%;
    }

    /* Accessibility: unanswered card highlight */
    .card.unanswered {
      border: 2px solid #b06400;
    }
    .card .unanswered-msg {
      color: #b06400;
      font-size: 0.85rem;
      margin-top: 4px;
    }

    /* Button states */
    button:hover {
      background: #0062d1;
      box-shadow: 0 4px 10px rgba(0,0,0,0.25);
    }
    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Disclaimer callout */
    .disclaimer-callout {
      background: #fffbe6;
      border-left: 4px solid #b06400;
      border-radius: 6px;
      padding: 10px 14px;
      font-size: 0.9rem;
      color: #554400;
      margin-bottom: 12px;
    }

    /* Call 211 button */
    .call-211-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #1d7a35;
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 12px 22px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
      margin-top: 10px;
    }
    .call-211-btn:hover {
      background: #15612a;
    }
    .call-211-btn:focus-visible {
      outline: 3px solid #005fcc;
      outline-offset: 2px;
    }

    /* Print button */
    .print-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #555;
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 10px 18px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 10px;
      margin-left: 8px;
    }
    .print-btn:hover {
      background: #333;
    }

    /* Action buttons row */
    .result-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
      align-items: center;
    }

    /* Risk icons alongside pills */
    .risk-icon {
      margin-right: 4px;
    }

    /* Insurance support card */
    .insurance-support {
      background: #fff;
      border-radius: 12px;
      padding: 16px 18px;
      margin-top: 12px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
      border-left: 4px solid #007aff;
      font-size: 0.95rem;
    }
    .insurance-support h3 {
      margin: 0 0 8px;
      font-size: 1.05rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .insurance-support ul {
      margin: 8px 0;
      padding-left: 18px;
    }
    .insurance-support ul li {
      margin-bottom: 6px;
    }
    .ins-script {
      background: #f0f4ff;
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.95rem;
      margin: 12px 0;
      line-height: 1.5;
    }
    .ins-how {
      margin-top: 10px;
      font-weight: 600;
    }
    .call-insurance-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #007aff;
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 12px 22px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
      margin-top: 10px;
    }
    .call-insurance-btn:hover {
      background: #0062d1;
    }
    .call-insurance-btn:focus-visible {
      outline: 3px solid #005fcc;
      outline-offset: 2px;
    }
    .ins-trust-note {
      font-size: 0.8rem;
      color: #666;
      margin-bottom: 8px;
      font-style: italic;
    }
    /* Insurance Q: skip link */
    .skip-link {
      display: inline-block;
      font-size: 0.85rem;
      color: #007aff;
      cursor: pointer;
      margin-top: 8px;
      text-decoration: underline;
      background: none;
      border: none;
      padding: 0;
      box-shadow: none;
    }
    .skip-link:hover {
      color: #0062d1;
    }

    /* Print stylesheet */
    @media print {
      body {
        background: #fff;
        padding: 0;
        font-size: 12pt;
      }
      .app-container {
        max-width: 100%;
      }
      form#risk-form,
      .top-row,
      .actions,
      .call-211-btn,
      .print-btn,
      .result-actions button {
        display: none !important;
      }
      .result, .resources, .insurance-support {
        box-shadow: none;
        border: 1px solid #ccc;
        break-inside: avoid;
      }
      .insurance-support {
        border-left: 4px solid #000;
      }
      .call-insurance-btn {
        display: none !important;
      }
      a.resource-link::after {
        content: " (" attr(href) ")";
        font-size: 0.8em;
        color: #555;
      }
      .disclaimer-callout {
        border-left-color: #000;
        background: #f9f9f9;
      }
    }
  </style>
</head>
<body>
  <div class="app-container">
    <a href="#risk-form" class="sr-only" style="position:absolute;left:-9999px;top:0;padding:8px;background:#005fcc;color:#fff;z-index:100;" onfocus="this.style.left='0'" onblur="this.style.left='-9999px'">Skip to screening form</a>
    <header>
      <h1 data-i18n="title">Post-Discharge Social Needs Screener</h1>
      <p data-i18n="subtitle">
        Answer a few questions to identify social needs that may affect your recovery after leaving the hospital. This is a simple screening tool, not a diagnosis.
      </p>
      <div class="disclaimer-callout" data-i18n="topDisclaimer">
        This tool is for demonstration and screening purposes only. It is not a medical device and should not replace clinical judgment or treatment decisions.
      </div>
      <div class="top-row">
        <div class="language-select">
          <label for="language" data-i18n="languageLabel">Language:</label>
          <select id="language">
            <option value="en">English</option>
            <option value="es">Español</option>
            <option value="ht">Kreyòl Ayisyen</option>
          </select>
        </div>
        <div class="county-select">
          <label for="county" data-i18n="countyLabel">Where do you live?</label>
          <select id="county">
            <option value="miami">Miami-Dade / Monroe (211 Miami)</option>
            <option value="broward">Broward (211 Broward)</option>
            <option value="palmbeach">Palm Beach / Treasure Coast (211 Palm Beach)</option>
            <option value="other">Other South Florida / Not sure</option>
          </select>
        </div>
      </div>
    </header>

    <main>
    <form id="risk-form">
      <div class="progress-container">
        <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
        <div class="progress-label" id="progress-label">Question 1 of 9</div>
      </div>
      <div class="cards" id="cards">
        <!-- Q1 Polypharmacy -->
        <div class="card" data-question="q1">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">💊</span>
              <span data-i18n="q1">How many different medicines do you take every day?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q1" value="0" /><span data-i18n="q1o1">0–3 medicines</span></label>
              <label><input type="radio" name="q1" value="1" /><span data-i18n="q1o2">4–6 medicines</span></label>
              <label><input type="radio" name="q1" value="2" /><span data-i18n="q1o3">7 or more medicines</span></label>
            </div>
          </fieldset>
        </div>

        <!-- Insurance routing question (not scored) -->
        <div class="card" data-question="qIns">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">🛡️</span>
              <span data-i18n="qIns">Do you have health insurance or a health plan?</span>
            </legend>
            <div class="ins-trust-note" data-i18n="insTrust">This helps us find the right resources for you. Your answer is private and will not be shared.</div>
            <div class="card-options">
              <label><input type="radio" name="qIns" value="commercial" /><span data-i18n="qInsO1">Yes, through my job or the Marketplace</span></label>
              <label><input type="radio" name="qIns" value="medicare" /><span data-i18n="qInsO2">Yes, Medicare (age 65+ or disability)</span></label>
              <label><input type="radio" name="qIns" value="medicaid" /><span data-i18n="qInsO3">Yes, Medicaid (state program)</span></label>
              <label><input type="radio" name="qIns" value="unsure" /><span data-i18n="qInsO4">I'm not sure</span></label>
              <label><input type="radio" name="qIns" value="none" /><span data-i18n="qInsO5">No, I don't have insurance</span></label>
            </div>
            <button type="button" class="skip-link" id="skip-insurance" data-i18n="insSkip">Skip this question</button>
          </fieldset>
        </div>

        <!-- Q2 Literacy -->
        <div class="card" data-question="q2">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">📖</span>
              <span data-i18n="q2">Do you have trouble reading or understanding written health information?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q2" value="0" /><span data-i18n="q2o1">No, I understand it well</span></label>
              <label><input type="radio" name="q2" value="1" /><span data-i18n="q2o2">Sometimes</span></label>
              <label><input type="radio" name="q2" value="2" /><span data-i18n="q2o3">Yes, I often have trouble</span></label>
            </div>
          </fieldset>
        </div>

        <!-- Q3 Compliance -->
        <div class="card" data-question="q3">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">⏰</span>
              <span data-i18n="q3">How often do you miss medicines or medical appointments?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q3" value="0" /><span data-i18n="q3o1">Almost never</span></label>
              <label><input type="radio" name="q3" value="1" /><span data-i18n="q3o2">Sometimes</span></label>
              <label><input type="radio" name="q3" value="2" /><span data-i18n="q3o3">Often</span></label>
            </div>
          </fieldset>
        </div>

        <!-- Q4 Transportation -->
        <div class="card" data-question="q4">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">🚗</span>
              <span data-i18n="q4">How easy is it for you to get to your clinic, hospital, or pharmacy?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q4" value="0" /><span data-i18n="q4o1">Very easy</span></label>
              <label><input type="radio" name="q4" value="1" /><span data-i18n="q4o2">Sometimes hard</span></label>
              <label><input type="radio" name="q4" value="2" /><span data-i18n="q4o3">Very hard / I usually can't</span></label>
            </div>
          </fieldset>
        </div>

        <!-- Q5 Support network -->
        <div class="card" data-question="q5">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">👪</span>
              <span data-i18n="q5">Who helps you with your health care at home?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q5" value="0" /><span data-i18n="q5o1">Strong support (family, friends, caregiver)</span></label>
              <label><input type="radio" name="q5" value="1" /><span data-i18n="q5o2">Some support</span></label>
              <label><input type="radio" name="q5" value="2" /><span data-i18n="q5o3">Little or no support</span></label>
            </div>
          </fieldset>
        </div>

        <!-- Q6 Prior utilization -->
        <div class="card" data-question="q6">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">🏥</span>
              <span data-i18n="q6">In the last 6 months, how many times were you in the ER or hospital?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q6" value="0" /><span data-i18n="q6o1">0 times</span></label>
              <label><input type="radio" name="q6" value="1" /><span data-i18n="q6o2">1–2 times</span></label>
              <label><input type="radio" name="q6" value="2" /><span data-i18n="q6o3">3 or more times</span></label>
            </div>
          </fieldset>
        </div>

        <!-- Q7 Housing -->
        <div class="card" data-question="q7">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">🏠</span>
              <span data-i18n="q7">Do you have a stable place to live?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q7" value="0" /><span data-i18n="q7o1">Yes, stable housing</span></label>
              <label><input type="radio" name="q7" value="1" /><span data-i18n="q7o2">Sometimes unsure</span></label>
              <label><input type="radio" name="q7" value="2" /><span data-i18n="q7o3">No, housing is unstable or I am homeless</span></label>
            </div>
          </fieldset>
        </div>

        <!-- Q8 Confidence / self-management -->
        <div class="card" data-question="q8">
          <fieldset class="card-radio-group">
            <legend>
              <span class="card-emoji" aria-hidden="true">💪</span>
              <span data-i18n="q8">How confident do you feel managing your health at home?</span>
            </legend>
            <div class="card-options">
              <label><input type="radio" name="q8" value="0" /><span data-i18n="q8o1">Very confident</span></label>
              <label><input type="radio" name="q8" value="1" /><span data-i18n="q8o2">Somewhat confident</span></label>
              <label><input type="radio" name="q8" value="2" /><span data-i18n="q8o3">Not confident</span></label>
            </div>
          </fieldset>
        </div>
      </div>

      <div class="wizard-nav" id="wizard-nav">
        <button type="button" id="btn-back" class="btn-back" data-i18n="back">Back</button>
        <button type="button" id="btn-next" class="btn-next" data-i18n="next">Next</button>
      </div>

      <div class="actions" id="actions-row">
        <button type="button" id="calculate" data-i18n="calculate">
          Calculate risk score
        </button>
        <button type="button" id="reset-btn" style="background:#888;" data-i18n="startOver">
          Start over
        </button>
      </div>
    </form>

    <section id="result" class="result" aria-live="polite" style="display:none;">
      <div class="result-header">
        <div>
          <strong data-i18n="yourScore">Your score:</strong>
          <span id="score-value">--</span>
        </div>
        <div id="risk-pill" class="pill">
          <span id="risk-icon" class="risk-icon" aria-hidden="true"></span>
          <span id="risk-label">--</span>
        </div>
      </div>
      <p id="risk-message" style="margin: 8px 0 0;"></p>
      <div class="result-actions">
        <a id="call-211-btn" class="call-211-btn" href="tel:211" data-i18n-aria="call211Aria" aria-label="Call 2-1-1 now">
          <span aria-hidden="true">📞</span> <span data-i18n="call211">Call 211 Now</span>
        </a>
        <button type="button" class="print-btn" id="print-btn" data-i18n="printSummary">
          Print Summary
        </button>
        <button type="button" class="print-btn" id="reset-btn-results" data-i18n="startOver" style="background:#007aff;">
          Start over
        </button>
      </div>
    </section>

    <section id="insurance-support" class="insurance-support" aria-live="polite" style="display:none;">
      <!-- Populated by JS based on insurance status -->
    </section>

    <section id="resources" class="resources" aria-live="polite" style="display:none;">
      <div class="resources-header">
        <div class="resources-title">
          <span class="icon" aria-hidden="true">🧭</span>
          <span data-i18n="resourcesTitle">Local 211 resources for you</span>
        </div>
        <div class="resources-meta" id="resources-meta"></div>
      </div>
      <ul class="resource-list" id="resource-list"></ul>
      <p class="disclaimer" data-i18n="resourcesNote">
        Dial 2-1-1 any time for free, confidential help in English, Spanish, or Haitian Creole.
      </p>
    </section>
    </main>
  </div>

