        qIns: "\u00c8ske ou gen asirans sante oswa yon plan sante?",
        qInsO1: "Wi, nan travay mwen oswa Marketplace la",
        qInsO2: "Wi, Medicare (laj 65+ oswa andikap)",
        qInsO3: "Wi, Medicaid (pwogram leta)",
        qInsO4: "Mwen pa s\u00e8ten",
        qInsO5: "Non, mwen pa gen asirans",
        insTrust: "Sa ede nou jwenn bon res\u00f2s pou ou. Repons ou a prive epi yo p ap pataje l.",
        insSkip: "Sote kesyon sa a",
        insHeadingTeam: "Ekip sip\u00f2 ou",
        insHeadCommercial: "Ou deja gen yon enfimy\u00e8 ou ka rele",
        insHeadMedicare: "\u00c8d gratis nan Medicare",
        insHeadMedicaid: "\u00c8d gratis nan plan Medicaid ou",
        insHeadUnsure: "Ou ka gen sip\u00f2 ou pa konnen",
        insBodyCommercial: "Plan sante ou gen yon ekip ki travay pou ede ou rete an sante apr\u00e8 ou soti lopital. Sa enkli nan plan ou san okenn fr\u00e8 siplemant\u00e8.",
        insBodyMedicare: "Medicare gen pwogram gratis pou ede ou rete an sante apr\u00e8 lopital.",
        insBodyMedicaid: "Plan Medicaid ou gen yon ekip swen ki ka ede ou rete an sante. Li gratis.",
        insBodyUnsure: "Anpil moun gen asirans oswa benefis yo pa konnen. Li v\u00f2 la p\u00e8n tcheke \u2014 ou ka gen yon ekip gratis ki pare pou ede ou.",
        insBulletNurse: "Yon enfimy\u00e8 ou ka rele ak kesyon sante",
        insBulletMeds: "\u00c8d pou konprann medikaman ou yo",
        insBulletAppt: "Rap\u00e8l pou randevou swivi",
        insBulletDoctors: "Jwenn dokt\u00e8 tou pre ou",
        insBulletRides: "Transp\u00f2 pou ale kay dokt\u00e8",
        insBulletCareManager: "Yon manadjè swen ki asiyen pou ou",
        insBulletCommunity: "Koneksyon ak pwogram kominot\u00e8",
        insFlipCard: "Vire kat asirans ou. Rele nimewo \"S\u00e8vis Manm\" ki d\u00e8y\u00e8 a.",
        insScript: "Di: \"Mwen f\u00e8k soti lopital. Mwen ta renmen pale ak yon moun sou \u00e8d pou rete an sante.\"",
        insTime: "Sa pran anviwon 5 minit.",
        insMedicarePhone: "Rele 1-800-MEDICARE (1-800-633-4227) \u2014 disponib 24 \u00e8 sou 24.",
        insMedicareMA: "Si ou gen yon plan tankou Humana, Aetna, oswa UnitedHealthcare, rele nimewo ki sou kat asirans ou tou. Yo ka gen sip\u00f2 siplemant\u00e8.",
        insMedicaidCall: "Rele nimewo ki d\u00e8y\u00e8 kat Medicaid ou epi mande \"Jesyon Swen.\"",
        insMedicaidFallback: "Si ou pa s\u00e8ten ki plan ou genyen, rele Florida Medicaid nan 1-877-254-1055.",
        insUnsureSteps: "Chache yon kat asirans nan b\u00f2s ou, mande depatman faktirasyon lopital la, oswa rele 211 \u2014 yo ka ede ou jwenn.",
        ins211CoverageCheck: "211 ka ede ou tou pou konnen si ou kalifye pou asirans sante gratis oswa bon mache.",
        btnCallMemberSvc: "Rele S\u00e8vis Manm",
        btnCallMedicare: "Rele 1-800-MEDICARE",
        btnCallMedicaid: "Rele Florida Medicaid",
        btnCall211Check: "Rele 211 pou tcheke"
      }
    };

    /* ============================================================
       DOM references
       ============================================================ */
    const langSelect = document.getElementById("language");
    const countySelect = document.getElementById("county");
    const scoreValueEl = document.getElementById("score-value");
    const riskLabelEl = document.getElementById("risk-label");
    const riskPillEl = document.getElementById("risk-pill");
    const riskIconEl = document.getElementById("risk-icon");
    const riskMessageEl = document.getElementById("risk-message");
    const resourcesMetaEl = document.getElementById("resources-meta");
    const resourceListEl = document.getElementById("resource-list");
    const resultSection = document.getElementById("result");
    const resourcesSection = document.getElementById("resources");
    const call211Btn = document.getElementById("call-211-btn");

    /* ============================================================
       Lightweight anonymous analytics (no PII, no cookies)
       Sends a single beacon per event — works even if page closes.
       Falls back silently if no endpoint is configured.
       ============================================================ */
    const ANALYTICS_ENDPOINT = ""; // Set to your endpoint URL when ready, e.g. "/api/events"
    function trackEvent(name, data) {
      if (!ANALYTICS_ENDPOINT) return;
      var payload = JSON.stringify({
        event: name,
        ts: new Date().toISOString(),
        lang: langSelect.value,
        county: countySelect.value,
        data: data || {}
      });
      if (navigator.sendBeacon) {
        navigator.sendBeacon(ANALYTICS_ENDPOINT, payload);
      }
    }

    /* ============================================================
       i18n application
       ============================================================ */
    function applyLanguage(lang) {
      var strings = i18n[lang] || i18n.en;
      document.documentElement.lang = lang;
      document.title = strings.title;
      document.querySelectorAll("[data-i18n]").forEach(function(el) {
        var key = el.getAttribute("data-i18n");
        if (strings[key]) {
          el.textContent = strings[key];
        }
      });
    }

    langSelect.addEventListener("change", function(e) {
      applyLanguage(e.target.value);
      updateProgressLabel();
      trackEvent("language_change");
    });

    /* ============================================================
       Wizard: one question at a time
       ============================================================ */
    var allCards = document.querySelectorAll(".card");
    var currentStep = 0;
    var totalSteps = allCards.length; // now 9
    var progressFill = document.getElementById("progress-fill");
    var progressLabelEl = document.getElementById("progress-label");
    var btnBack = document.getElementById("btn-back");
    var btnNext = document.getElementById("btn-next");
    var wizardNav = document.getElementById("wizard-nav");
    var actionsRow = document.getElementById("actions-row");
    var insuranceSupportEl = document.getElementById("insurance-support");

    // Get the radio name for any card via its data-question attribute
    function getCardRadioName(step) {
      return allCards[step].getAttribute("data-question");
    }

    // Is the insurance question step?
    function isInsuranceStep(step) {
      return getCardRadioName(step) === "qIns";
    }

    function showStep(step) {
      currentStep = step;
      allCards.forEach(function(card, i) {
        card.classList.toggle("active", i === step);
      });
      progressFill.style.width = ((step + 1) / totalSteps * 100) + "%";
      updateProgressLabel();

      // Show/hide nav buttons
      btnBack.style.visibility = step === 0 ? "hidden" : "visible";

      if (step === totalSteps - 1) {
        btnNext.style.display = "none";
        actionsRow.classList.add("visible");
        wizardNav.style.display = "flex";
      } else {
        btnNext.style.display = "";
        actionsRow.classList.remove("visible");
        wizardNav.style.display = "flex";
      }
    }

    function updateProgressLabel() {
      var strings = i18n[langSelect.value] || i18n.en;
      var tmpl = strings.progressLabel || "Question {n} of 9";
      progressLabelEl.textContent = tmpl.replace("{n}", currentStep + 1);
    }

    btnBack.addEventListener("click", function() {
      if (currentStep > 0) showStep(currentStep - 1);
    });

    btnNext.addEventListener("click", function() {
      var qName = getCardRadioName(currentStep);
      // Insurance question is skippable — allow Next without answer
      if (isInsuranceStep(currentStep)) {
        if (currentStep < totalSteps - 1) showStep(currentStep + 1);
        return;
      }
      var selected = document.querySelector('input[name="' + qName + '"]:checked');
      if (!selected) {
        var card = allCards[currentStep];
        card.classList.add("unanswered");
        var existing = card.querySelector(".unanswered-msg");
        if (!existing) {
          var strings = i18n[langSelect.value] || i18n.en;
          var msg = document.createElement("div");
          msg.className = "unanswered-msg";
          msg.textContent = strings.pleaseAnswer;
          card.querySelector(".card-options").appendChild(msg);
        }
        return;
      }
      if (currentStep < totalSteps - 1) showStep(currentStep + 1);
    });

    // Skip insurance question button
    document.getElementById("skip-insurance").addEventListener("click", function() {
      if (currentStep < totalSteps - 1) showStep(currentStep + 1);
    });

    // Auto-advance after selecting a radio option
    document.querySelectorAll('.card-options input[type="radio"]').forEach(function(radio) {
      radio.addEventListener("change", function() {
        var card = allCards[currentStep];
        card.classList.remove("unanswered");
        var msg = card.querySelector(".unanswered-msg");
        if (msg) msg.remove();

        if (currentStep < totalSteps - 1) {
          setTimeout(function() {
            showStep(currentStep + 1);
          }, 300);
        }
      });
    });

    // Initialize wizard at step 0
    showStep(0);

    /* ============================================================
       211 provider profiles (with i18n note keys)
       ============================================================ */
    function get211Profile(county, lang) {
      var strings = i18n[lang] || i18n.en;
      switch (county) {
        case "miami":
          return {
            name: "211 Miami", area: "Miami-Dade & Monroe",
            phone: "(305) 631-4211", dialLabel: "2-1-1",
            tel: "tel:+13056314211",
            site: "https://211miami.org",
            note: strings.note211Miami
          };
        case "broward":
          return {
            name: "211 Broward", area: "Broward County",
            phone: "(954) 537-0211", dialLabel: "2-1-1",
            tel: "tel:+19545370211",
            site: "https://www.211-broward.org",
            note: strings.note211Broward
          };
        case "palmbeach":
          return {
            name: "211 Palm Beach / Treasure Coast", area: "Palm Beach & Treasure Coast",
            phone: "2-1-1", dialLabel: "2-1-1",
            tel: "tel:211",
            site: "https://www.211palmbeach.org",
            note: strings.note211PalmBeach
          };
        default:
          return {
            name: "Florida 211", area: "South Florida",
            phone: "2-1-1", dialLabel: "2-1-1",
            tel: "tel:211",
            site: "https://fl211.org",
            note: strings.note211Florida
          };
      }
    }

    /* ============================================================
       Render 211 meta (XSS-safe — no innerHTML)
       ============================================================ */
    function render211Meta(profile) {
      resourcesMetaEl.textContent = "";
      var strong = document.createElement("strong");
      strong.textContent = profile.name;
      resourcesMetaEl.appendChild(strong);
      resourcesMetaEl.appendChild(document.createElement("br"));
      resourcesMetaEl.appendChild(document.createTextNode(profile.area));
      resourcesMetaEl.appendChild(document.createElement("br"));
      var phoneLink = document.createElement("a");
      phoneLink.href = profile.tel;
      phoneLink.textContent = profile.phone;
      resourcesMetaEl.appendChild(phoneLink);
    }

    /* ============================================================
       Build need tags (translated, threshold >= 1)
       ============================================================ */
    function buildNeedTags(answers, lang) {
      var strings = i18n[lang] || i18n.en;
      var needs = [];

      if (answers.q4 >= 1) {
        needs.push({ id: "transport", label: strings.needTransport, desc: strings.needTransportDesc });
      }
      if (answers.q7 >= 1) {
        needs.push({ id: "housing", label: strings.needHousing, desc: strings.needHousingDesc });
      }
      if (answers.q5 >= 1) {
        needs.push({ id: "support", label: strings.needSupport, desc: strings.needSupportDesc });
      }
      if (answers.q2 >= 1) {
        needs.push({ id: "literacy", label: strings.needLiteracy, desc: strings.needLiteracyDesc });
      }
      if (answers.q3 >= 1 || answers.q1 >= 1) {
        needs.push({ id: "meds", label: strings.needMeds, desc: strings.needMedsDesc });
      }
      if (answers.q6 >= 1) {
        needs.push({ id: "highUse", label: strings.needHighUse, desc: strings.needHighUseDesc });
      }
      if (answers.q8 >= 1) {
        needs.push({ id: "selfMgmt", label: strings.needSelfMgmt, desc: strings.needSelfMgmtDesc });
      }

      return needs;
    }

    /* ============================================================
       Render resources (XSS-safe — no innerHTML)
       ============================================================ */
    function renderResources(profile, needs, lang, totalScore) {
      var strings = i18n[lang] || i18n.en;
      render211Meta(profile);
      resourceListEl.textContent = "";

      if (needs.length === 0 && totalScore !== null) {
        var li = document.createElement("li");
        li.textContent = strings.noRisksFlagged.replace("{name}", profile.name);
        resourceListEl.appendChild(li);
      }

      needs.forEach(function(need) {
        var li = document.createElement("li");
        var strong = document.createElement("strong");
        strong.textContent = need.label;
        li.appendChild(strong);
        var tag = document.createElement("span");
        tag.className = "tag";
        tag.textContent = "211";
        li.appendChild(tag);
        li.appendChild(document.createElement("br"));
        li.appendChild(document.createTextNode(need.desc));
        resourceListEl.appendChild(li);
      });

      // "Visit / Call" link
      var liLink = document.createElement("li");
      var visitText = strings.visitOrCall.split("{name}");
      liLink.appendChild(document.createTextNode(visitText[0]));
      var siteLink = document.createElement("a");
      siteLink.className = "resource-link";
      siteLink.href = profile.site;
      siteLink.target = "_blank";
      siteLink.rel = "noopener noreferrer";
      siteLink.textContent = profile.name;
      liLink.appendChild(siteLink);
      var afterName = (visitText[1] || "").split("{phone}");
      liLink.appendChild(document.createTextNode(afterName[0]));
      var phoneLink = document.createElement("a");
      phoneLink.href = profile.tel;
      phoneLink.textContent = profile.phone;
      liLink.appendChild(phoneLink);
      liLink.appendChild(document.createTextNode(afterName[1] || ""));
      resourceListEl.appendChild(liLink);

      // Update the Call 211 button href
      call211Btn.href = profile.tel;
    }

    /* ============================================================
       Validation: highlight unanswered cards
       ============================================================ */
    function clearValidation() {
      document.querySelectorAll(".card.unanswered").forEach(function(card) {
        card.classList.remove("unanswered");
        var msg = card.querySelector(".unanswered-msg");
        if (msg) msg.remove();
      });
    }

    function highlightUnanswered(lang) {
      var strings = i18n[lang] || i18n.en;
      var firstUnanswered = null;
      for (var i = 1; i <= 8; i++) {
        var selected = document.querySelector('input[name="q' + i + '"]:checked');
        if (!selected) {
          var card = document.querySelector('[data-question="q' + i + '"]');
          if (card && !card.classList.contains("unanswered")) {
            card.classList.add("unanswered");
            var msg = document.createElement("div");
            msg.className = "unanswered-msg";
            msg.textContent = strings.pleaseAnswer;
            card.querySelector(".card-options").appendChild(msg);
          }
          if (!firstUnanswered) firstUnanswered = card;
        }
      }
      if (firstUnanswered) {
        firstUnanswered.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    /* ============================================================
       Render insurance support card (branched by status)
       All content built via DOM — no innerHTML / XSS-safe
       ============================================================ */
    function renderInsuranceSupport(status, lang, profile) {
      var s = i18n[lang] || i18n.en;
      var el = insuranceSupportEl;
      el.textContent = "";

      // No card for uninsured or skipped — 211 section handles them
      if (!status || status === "none") {
        el.style.display = "none";
        // Add coverage check line to resources for uninsured
        if (status === "none") {
          var coverageLi = document.createElement("li");
          coverageLi.style.fontWeight = "600";
          coverageLi.textContent = s.ins211CoverageCheck;
          resourceListEl.appendChild(coverageLi);
        }
        return;
      }

      el.style.display = "";

      // Heading
      var h3 = document.createElement("h3");
      var headText = "";
      if (status === "commercial") headText = s.insHeadCommercial;
      else if (status === "medicare") headText = s.insHeadMedicare;
      else if (status === "medicaid") headText = s.insHeadMedicaid;
      else if (status === "unsure") headText = s.insHeadUnsure;
      h3.appendChild(document.createTextNode(headText));
      el.appendChild(h3);

      // Body paragraph
      var bodyP = document.createElement("p");
      if (status === "commercial") bodyP.textContent = s.insBodyCommercial;
      else if (status === "medicare") bodyP.textContent = s.insBodyMedicare;
      else if (status === "medicaid") bodyP.textContent = s.insBodyMedicaid;
      else if (status === "unsure") bodyP.textContent = s.insBodyUnsure;
      el.appendChild(bodyP);

      // Bullet list (varies by type)
      var ul = document.createElement("ul");
      var bullets = [];
      if (status === "commercial") {
        bullets = [s.insBulletNurse, s.insBulletMeds, s.insBulletAppt, s.insBulletDoctors];
      } else if (status === "medicare") {
        bullets = [s.insBulletNurse, s.insBulletMeds, s.insBulletAppt];
      } else if (status === "medicaid") {
        bullets = [s.insBulletCareManager, s.insBulletRides, s.insBulletMeds, s.insBulletCommunity];
      }
      // "unsure" gets no bullets — just action steps
      bullets.forEach(function(text) {
        var li = document.createElement("li");
        li.textContent = text;
        ul.appendChild(li);
      });
      if (bullets.length) el.appendChild(ul);

      // Action instructions
      if (status === "commercial") {
        var howP = document.createElement("p");
        howP.className = "ins-how";
        howP.textContent = s.insFlipCard;
        el.appendChild(howP);

        var scriptDiv = document.createElement("div");
        scriptDiv.className = "ins-script";
        scriptDiv.textContent = s.insScript + " " + s.insTime;
        el.appendChild(scriptDiv);

        var btn = document.createElement("a");
        btn.className = "call-insurance-btn";
        btn.href = "tel:";
        btn.textContent = s.btnCallMemberSvc;
        btn.addEventListener("click", function() { trackEvent("call_insurance_click", { type: "commercial" }); });
        el.appendChild(btn);

      } else if (status === "medicare") {
        var mcP = document.createElement("p");
        mcP.className = "ins-how";
        mcP.textContent = s.insMedicarePhone;
        el.appendChild(mcP);

        var maP = document.createElement("p");
        maP.textContent = s.insMedicareMA;
        el.appendChild(maP);

        var scriptDiv2 = document.createElement("div");
        scriptDiv2.className = "ins-script";
        scriptDiv2.textContent = s.insScript + " " + s.insTime;
        el.appendChild(scriptDiv2);

        var btn2 = document.createElement("a");
        btn2.className = "call-insurance-btn";
        btn2.href = "tel:+18006334227";
        btn2.textContent = s.btnCallMedicare;
        btn2.addEventListener("click", function() { trackEvent("call_insurance_click", { type: "medicare" }); });
        el.appendChild(btn2);

      } else if (status === "medicaid") {
        var mdP = document.createElement("p");
        mdP.className = "ins-how";
        mdP.textContent = s.insMedicaidCall;
        el.appendChild(mdP);

        var scriptDiv3 = document.createElement("div");
        scriptDiv3.className = "ins-script";
        scriptDiv3.textContent = s.insScript + " " + s.insTime;
        el.appendChild(scriptDiv3);

        var fbP = document.createElement("p");
        fbP.textContent = s.insMedicaidFallback;
        el.appendChild(fbP);

        var btn3 = document.createElement("a");
        btn3.className = "call-insurance-btn";
        btn3.href = "tel:+18772541055";
        btn3.textContent = s.btnCallMedicaid;
        btn3.addEventListener("click", function() { trackEvent("call_insurance_click", { type: "medicaid" }); });
        el.appendChild(btn3);

      } else if (status === "unsure") {
        var stepsP = document.createElement("p");
        stepsP.textContent = s.insUnsureSteps;
        el.appendChild(stepsP);

        var btn4 = document.createElement("a");
        btn4.className = "call-insurance-btn";
        btn4.href = "tel:211";
        btn4.textContent = s.btnCall211Check;
        btn4.addEventListener("click", function() { trackEvent("call_insurance_click", { type: "unsure" }); });
        el.appendChild(btn4);
      }
    }

    /* ============================================================
       Calculate handler
       ============================================================ */
    document.getElementById("calculate").addEventListener("click", function() {
      clearValidation();
      var total = 0;
      var answered = 0;
      var answers = {};

      // Score only the 8 health questions (q1-q8), skip qIns
      for (var i = 1; i <= 8; i++) {
        var selected = document.querySelector('input[name="q' + i + '"]:checked');
        if (selected) {
          answered++;
          var val = Number(selected.value);
          total += val;
          answers["q" + i] = val;
        } else {
          answers["q" + i] = null;
        }
      }

      // Read insurance status (may be null if skipped)
      var insEl = document.querySelector('input[name="qIns"]:checked');
      var insuranceStatus = insEl ? insEl.value : null;

      var currentLang = langSelect.value;
      var strings = i18n[currentLang] || i18n.en;
      var county = countySelect.value;
      var profile = get211Profile(county, currentLang);

      if (answered < 8) {
        // Navigate to first unanswered health question (skip insurance step)
        for (var j = 0; j < totalSteps; j++) {
          var qn = getCardRadioName(j);
          if (qn === "qIns") continue; // insurance is optional
          var check = document.querySelector('input[name="' + qn + '"]:checked');
          if (!check) { showStep(j); break; }
        }
        highlightUnanswered(currentLang);
        return;
      }

      // Hide wizard nav, show results
      wizardNav.style.display = "none";
      actionsRow.classList.remove("visible");

      // Hide form, show results
      document.querySelector(".progress-container").style.display = "none";
      document.querySelector(".cards").style.display = "none";
      resultSection.style.display = "";
      resourcesSection.style.display = "";
      scoreValueEl.textContent = total.toString();

      var label, msg, pillClass, icon;
      if (total <= 5) {
        label = strings.riskLow;
        msg = strings.msgLow;
        pillClass = "pill pill-low";
        icon = "\u2713";
      } else if (total <= 11) {
        label = strings.riskMedium;
        msg = strings.msgMedium;
        pillClass = "pill pill-medium";
        icon = "\u26a0";
      } else {
        label = strings.riskHigh;
        msg = strings.msgHigh;
        pillClass = "pill pill-high";
        icon = "\u26d4";
      }

      riskLabelEl.textContent = label;
      riskPillEl.className = pillClass;
      riskIconEl.textContent = icon;
      riskMessageEl.textContent = msg;

      var needs = buildNeedTags(answers, currentLang);
      renderResources(profile, needs, currentLang, total);

      // Render insurance support card (branched by status)
      renderInsuranceSupport(insuranceStatus, currentLang, profile);

      resultSection.scrollIntoView({ behavior: "smooth", block: "start" });

      // Analytics
      trackEvent("screening_complete", {
        score: total,
        tier: total <= 5 ? "low" : total <= 11 ? "medium" : "high",
        needs: needs.map(function(n) { return n.id; }),
        answered: answered,
        insuranceStatus: insuranceStatus || "skipped"
      });
    });

    /* ============================================================
       Reset / Start Over
       ============================================================ */
    function doReset() {
      clearValidation();
      document.getElementById("risk-form").reset();
      resultSection.style.display = "none";
      resourcesSection.style.display = "none";
      insuranceSupportEl.style.display = "none";
      document.querySelector(".progress-container").style.display = "";
      document.querySelector(".cards").style.display = "";
      showStep(0);
      window.scrollTo({ top: 0, behavior: "smooth" });
      trackEvent("reset");
    }
    document.getElementById("reset-btn").addEventListener("click", doReset);
    document.getElementById("reset-btn-results").addEventListener("click", doReset);

    /* ============================================================
       Print Summary
       ============================================================ */
    document.getElementById("print-btn").addEventListener("click", function() {
      window.print();
      trackEvent("print");
    });

    /* ============================================================
       Track 211 link clicks
       ============================================================ */
    call211Btn.addEventListener("click", function() {
      trackEvent("call_211_click");
    });

    /* ============================================================
       Initialize
       ============================================================ */
    applyLanguage("en");
  </script>
</body>
</html>
